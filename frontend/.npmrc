# react-scripts@5.0.1 (Create React App, last released 2022) declares a peer dependency on
# TypeScript ^3/^4 only. TypeScript 5 works fine with it at runtime - CRA just never updated its
# peer-dependency metadata before development stopped - but npm's default (strict, since npm 7)
# peer-dependency resolution rejects the install outright over that stale metadata, even though
# nothing is actually broken. legacy-peer-deps restores npm 6's warn-don't-fail behavior for this
# one, real, well-known false positive.
legacy-peer-deps=true
